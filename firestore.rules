rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "lcQwVHzPhoVietiyv6UsR71uf6H2";
    }
    match /{other=**} { allow read, write: if false; }
  }
}
